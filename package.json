{
  "name": "follow-audit",
  "version": "3.0.0",
  "private": true,
  "description": "A private, local-first workspace for reviewing Instagram and TikTok followers and following.",
  "keywords": [
    "instagram",
    "tiktok",
    "followers",
    "unfollowers",
    "privacy",
    "browser-script"
  ],
  "license": "MIT",
  "author": "marquezinii",
  "homepage": "https://marquezinii.github.io/follow-audit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marquezinii/follow-audit.git"
  },
  "bugs": {
    "url": "https://github.com/marquezinii/follow-audit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.cjs",
    "bundle": "esbuild src/main.ts --bundle --minify --sourcemap=external --loader:.svg=text --loader:.woff2=dataurl --target=chrome116,firefox124,safari17.4 --legal-comments=none --outfile=dist/dist.js",
    "prepare-pages": "node scripts/prepare-pages.cjs",
    "build": "npm run bundle && npm run prepare-pages",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src tests",
    "check:site": "node --check public/site.js && node scripts/check-site.cjs",
    "check": "npm run lint && npm run test && npm run typecheck && npm run check:site && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
